# EcoRoute — Environment Variables Example
# Copy this file to .env or set these in your Vercel / Netlify project settings

# Supabase Project URL (e.g. https://your-project.supabase.co)
SUPABASE_URL=https://your-project.supabase.co

# Supabase Public Anonymous API Key
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Note: In shared/supabaseClient.js, fallback demo credentials and local offline 
# simulation mode are automatically active when demo=1 or when remote Supabase 
# is unreachable, ensuring 100% reliable evaluation offline or without credentials.
